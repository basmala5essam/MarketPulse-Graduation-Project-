	measure 'Avg Return Day -1' =
			
			AVERAGE ( 'gold fact_events'[ret_m1] )
		lineageTag: f3281caf-3573-4184-8cc0-2a5f27fd9802

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Return Day +1' =
			
