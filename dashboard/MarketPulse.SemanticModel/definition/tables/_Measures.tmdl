		lineageTag: bab3dcf4-2fd3-4d23-b894-b142eef43b23

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Assets ($B)' =
			
			VAR d = MAX ( 'gold fact_fundamentals'[period_end] )
			RETURN DIVIDE ( CALCULATE ( SUM ( 'gold fact_fundamentals'[total_assets] ), 'gold fact_fundamentals'[period_end] = d ), 1000000000 )
		lineageTag: 11afc873-6be4-433c-9385-98e6846fdf78

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Equity ($B)' =
			
			VAR d = MAX ( 'gold fact_fundamentals'[period_end] )
			RETURN DIVIDE ( CALCULATE ( SUM ( 'gold fact_fundamentals'[equity] ), 'gold fact_fundamentals'[period_end] = d ), 1000000000 )
		lineageTag: 73504d86-ed3d-4206-b610-4dd155ff1f0d

