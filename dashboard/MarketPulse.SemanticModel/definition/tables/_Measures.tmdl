table _Measures
	lineageTag: fa285e24-6e62-4173-9fc1-48e2e6b56228

	measure 'Last Trading Date' =
			
			CALCULATE ( MAX ( 'gold dim_date'[date] ), 'gold fact_market_daily')
		formatString: General Date
		lineageTag: 29a0bfc4-9434-401e-807f-a2e9209f67f4

	measure 'First Trading Date' =
			
			CALCULATE ( MIN ( 'gold dim_date'[date] ), 'gold fact_market_daily' )
		formatString: General Date
		lineageTag: c1af492c-50c3-460b-8b7d-bd86aff801bd

	measure 'Number of Stocks' =
			
			DISTINCTCOUNT ( 'gold fact_market_daily'[company_key] )
		formatString: 0
		lineageTag: 3cb24f2e-36da-4415-ac6b-54d5042633fb

	measure 'Selected Stock' =
			
			SELECTEDVALUE ( 'gold dim_company'[ticker], "All stocks" )
		lineageTag: 16f4418c-740c-4bd4-802f-c77d3bc08a80

	measure 'Compare Stock' =
			
			SELECTEDVALUE ( CompareStock[Compare ticker], "None" )
		lineageTag: 9e8af62d-8208-4b23-84b1-3a4e380d81b3

	measure 'Period Label' =
			
			FORMAT ( [First Trading Date], "mmm yyyy" ) & " to " & FORMAT ( [Last Trading Date], "mmm yyyy" )
		lineageTag: 79144c54-6f89-4346-b5b3-7e4bb028a670

	measure 'Growth Title' =
			
			"Growth of 100 invested in " & FORMAT ( [First Trading Date], "mmmm yyyy" )
		lineageTag: 35e392f0-5ffb-4a6e-b0e1-a5391de58e3c

	measure 'EW Value' =
			
			VAR d = [Last Trading Date]
			RETURN
			    CALCULATE (
			        SUM ( 'gold fact_portfolio_daily'[value_index]),
			        'gold dim_portfolio'[portfolio_id] = 1,
			        'gold dim_date'[date] = d
			    )
		lineageTag: 038be3b9-7f9e-4cd0-b684-5a0ff352fd1b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EW Return' =
			
			CALCULATE (
			    PRODUCTX ( 'gold fact_portfolio_daily', 1 + 'gold fact_portfolio_daily'[daily_return] ) - 1,
			    'gold dim_portfolio'[portfolio_id]= 1
			)
		lineageTag: 187e4e73-adda-42f0-950f-527956860d4a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EW Volatility' =
			
			CALCULATE (
			    STDEV.S ( 'gold fact_portfolio_daily'[daily_return] ) * SQRT ( 252 ),
			    'gold dim_portfolio'[portfolio_id] = 1
			)
		lineageTag: caecaecb-2c51-4550-a4ce-4be4bd22c904

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EW Max Drawdown' =
			
			CALCULATE (
			    MIN ( 'gold fact_portfolio_daily'[drawdown] ),
			    'gold dim_portfolio'[portfolio_id] = 1
			)
		lineageTag: cb5e1bd2-90d1-49e1-9376-8deb81f602c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EW Sharpe' =
			
			DIVIDE (
			    CALCULATE (
			        AVERAGE ( 'gold fact_portfolio_daily'[daily_return] ),
			        'gold dim_portfolio'[portfolio_id] = 1
			    ) * 252,
			    [EW Volatility]
			)
		lineageTag: 10b0b99a-2dc5-4567-9ece-ea885b767e23

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EW Growth of 100' =
			
			CALCULATE (
			    SUM ( 'gold fact_portfolio_daily'[value_index] ),
			    'gold dim_portfolio'[portfolio_id] = 1
			)
		lineageTag: de950c04-60b1-4f55-89ba-55a908906a08

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'EW Drawdown' =
			
			CALCULATE (
			    SUM ( 'gold fact_portfolio_daily'[drawdown] ),
			    'gold dim_portfolio'[portfolio_id] = 1
			)
		lineageTag: b01531d1-892f-4f85-9e11-cf720b89666c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

