	measure 'Best Performer' =
			
			CONCATENATEX ( TOPN ( 1, VALUES ( 'gold dim_company'[ticker] ), [Total Return], DESC ), 'gold dim_company'[ticker], ", " )
		lineageTag: 321f1f27-7489-4f88-aae4-26a40f991e41

	measure 'Best Performer Return' =
			
			MAXX ( TOPN ( 1, VALUES ( 'gold dim_company'[ticker] ), [Total Return], DESC ), [Total Return] )
		lineageTag: 907fc838-497d-4db7-859d-55b0ed7b6bda

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Calmest Stock' =
			
			CONCATENATEX ( TOPN ( 1, VALUES ( 'gold dim_company'[ticker] ), [Annualized Volatility], ASC ), 'gold dim_company'[ticker], ", " )
		lineageTag: 36e5c1e2-02b0-423a-8a09-c5841e64406a

	measure 'Calmest Stock Volatility' =
			
			MINX ( VALUES ( 'gold dim_company'[ticker] ), [Annualized Volatility] )
		lineageTag: 3e355b22-8b32-497e-8e0a-58facd994d1c

