	measure 'Hero Subtitle' =
			
			"Best: " & [Best Performer] & " " & FORMAT ( [Best Performer Return], "+#,0%;-#,0%" )
			    & " | Calmest: " & [Calmest Stock] & ", " & FORMAT ( [Calmest Stock Volatility], "0.0%" ) & " volatility"
		lineageTag: 528be3f8-8576-46fe-bdda-979fc5e6c4c6

	measure 'Most Correlated Pair' =
			
			VAR t =
			    TOPN (
			        1,
			        FILTER (
			            CALCULATETABLE ( 'gold fact_correlation_pairs', 'gold fact_correlation_pairs'[window_type] = "full" ),
			            'gold fact_correlation_pairs'[company_key] < 'gold fact_correlation_pairs'[peer_company_key]
			        ),
			        'gold fact_correlation_pairs'[correlation], DESC
			    )
			RETURN
			    MAXX (
			        t,
			        RELATED ( 'gold dim_company'[ticker] ) & "-" & RELATED ( 'gold dim_company_peer'[ticker] )
			            & " (" & FORMAT ( 'gold fact_correlation_pairs'[correlation], "0.00" ) & ")"
			    )
		lineageTag: 63175135-f296-4cc3-a995-a0bfe3f24d56

	measure 'Revenue ($B)' =
			
			DIVIDE ( SUM ( 'gold fact_fundamentals'[revenue] ), 1000000000 )
		lineageTag: cb72c849-18e7-4548-a7a8-7b9b80ac20d5

