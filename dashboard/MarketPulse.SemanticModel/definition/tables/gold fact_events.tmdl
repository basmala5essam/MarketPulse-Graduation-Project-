	partition 'gold fact_events' = m
		mode: import
		source =
				let
				    Source = Sql.Database("196.221.145.204,1433", "MarketPulseDW"),
				    gold_fact_events = Source{[Schema="gold",Item="fact_events"]}[Data],
				    #"Removed Columns" = Table.RemoveColumns(gold_fact_events,{"gold.dim_company", "gold.dim_date(event_date_key)", "gold.dim_date(reaction_date_key)"}),
				    Joined  = Table.NestedJoin(#"Removed Columns", {"event_id"}, #"gold fact_event_study", {"event_id"}, "es", JoinKind.LeftOuter),
				    Expand  = Table.ExpandTableColumn(Joined, "es",
				                {"ret_m1", "ret_d0", "ret_p1", "ret_p2", "abn_d0", "car_m1_p1", "volume_ratio_d0"}),
				    Flag    = Table.AddColumn(Expand, "is_earnings_duplicate",
				                each [event_type] = "8-K" and [items] <> null and Text.Contains([items], "2.02"), type logical)
				in
				    Flag

